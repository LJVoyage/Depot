
:root{
   
}

.fileBrowser {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #F0F2F5;
}


.file-label{
    height: 31px;
    min-height: 31px;
    background-color: #f5f5f5;
    border-bottom-color: #d0d5e0;
    border-bottom-width: 1px;
    flex-direction: row;
    
}

.file-label {
    
}

.label-container {
    height: 40px;
    min-height: 40px;
    padding: 0 10px;
    background-color: #f5f5f5;

    border-bottom-color: #d0d5e0;
    border-bottom-width: 1px;

}

.fileBrowser-label-item {
    width: 100px;
    height: 35px;
    background-color: white;
    border-width: 1px 1px 0 1px;
    border-radius: 15px 15px 0 0;
    border-color: #d0d5e0;
}

.path-container {
    padding: 0 10px;
    background-color: #ffffff;
    flex-direction: row;
    height: 45px;
    align-items: center; /* 垂直居中 (交叉轴) */
    border-bottom-color: #d0d5e0;
    border-bottom-width: 1px;
}

.path-button {
    width: 32px;
    height: 32px;
    background-color: transparent;
}

.path-textfield {
    flex-grow: 1;
    height: 32px;
}

.path-textfield > TextInput {
    background-color: #f8f9fc;
    color: black;
    border-width: 1px;
    border-color: #d0d5e0;
    border-radius: 6px;
}


.file-container {
    height: 50px;
    flex-direction: row;
    flex-grow: 1;
}

.file-container-left {
    width: 180px;
}
.file-container-right {
    flex-grow: 1;
}

.bottom-container {
    margin-left: auto;
    height: 35px;
    width: 100%;
}



